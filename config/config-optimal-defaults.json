{
  "agents": {
    "defaults": {
      "memorySearch": {
        "enabled": true,
        "sources": ["memory", "sessions"],
        "experimental": { "sessionMemory": true }
      },
      "compaction": {
        "memoryFlush": { "enabled": true }
      },
      "heartbeat": { "every": "1h", "model": "anthropic/claude-3-5-haiku-latest" },
      "maxConcurrent": 4,
      "subagents": { "maxConcurrent": 8 }
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  }
}
