# OpenClaw Starter Kit
# Copy to .env and fill in your values

# ═══════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════

# Anthropic API Key (powers Claude)
# Get one: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ═══════════════════════════════════════════════════════════
# CHANNEL (pick one)
# ═══════════════════════════════════════════════════════════

# Telegram (easiest) - message @BotFather
TELEGRAM_BOT_TOKEN=

# Discord - https://discord.com/developers
DISCORD_BOT_TOKEN=

# ═══════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════

# Gemini API (FREE!) - for RAG embeddings
# Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Brave Search API - for web search
BRAVE_API_KEY=

# DeepSeek API - for cheap coding help
DEEPSEEK_API_KEY=
