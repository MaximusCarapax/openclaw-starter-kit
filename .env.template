# OpenClaw Starter Kit
# Copy to .env and fill in your values

# ═══════════════════════════════════════════════════════════
# WORKSPACE TOOLS
# These keys are used by tools in the tools/ folder
# ═══════════════════════════════════════════════════════════

# Gemini API (FREE!) - for RAG embeddings & summaries
# Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek API - for cheap coding help (~$0.14/M tokens)
# Get one: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Notion API - for notes, databases, task management
# Get one: https://www.notion.so/my-integrations
NOTION_API_KEY=

# Brave Search API - for web search
# Get one: https://brave.com/search/api
BRAVE_API_KEY=

# ═══════════════════════════════════════════════════════════
# NOTE: Anthropic & Channel tokens are configured via
# 'openclaw init' and stored in ~/.openclaw/openclaw.json
# You don't need to add them here.
#
# Google (Gmail, Calendar) uses OAuth - run:
#   node tools/gmail.js auth
#   node tools/google-calendar.js auth
# ═══════════════════════════════════════════════════════════
