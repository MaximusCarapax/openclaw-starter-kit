# OpenClaw Starter Kit - Environment Variables
# Copy this to .env and fill in your values

# ═══════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════

# Anthropic API Key (powers Claude)
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ═══════════════════════════════════════════════════════════
# CHANNEL (pick one)
# ═══════════════════════════════════════════════════════════

# Telegram (easiest): Message @BotFather to create a bot
TELEGRAM_BOT_TOKEN=

# Discord: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# ═══════════════════════════════════════════════════════════
# RAG (Vector Memory)
# ═══════════════════════════════════════════════════════════

# Gemini API Key (FREE!) - for embeddings
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ChromaDB URL (default: local Docker)
CHROMA_URL=http://localhost:8000

# ═══════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════

# Brave Search API (for web search)
# Get one at: https://brave.com/search/api/
BRAVE_API_KEY=

# DeepSeek API (cheap coding assistance)
# Get one at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# OpenAI API (alternative embeddings/models)
OPENAI_API_KEY=
