# OpenClaw Starter Kit
# Copy to .env and fill in your values

# ═══════════════════════════════════════════════════════════
# WORKSPACE TOOLS
# These keys are used by tools in the tools/ folder
# ═══════════════════════════════════════════════════════════

# Gemini API (FREE!) - for RAG embeddings & summaries
# Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Second Gemini key (optional) - doubles your free quota
# Use a different Google account
GEMINI_API_KEY_2=

# OpenAI API (optional) - more reliable embeddings (~$0.02/M tokens)
# Use instead of Gemini if you hit quota limits
# Get one: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek API - for cheap coding help (~$0.14/M tokens)
# Get one: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenRouter API - fallback + access to 100+ models
# Get one: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Notion API - for notes, databases, task management
# Get one: https://www.notion.so/my-integrations
NOTION_API_KEY=

# 2Captcha API - for bypassing CAPTCHAs (~$3/1000 solves)
# Get one: https://2captcha.com
TWOCAPTCHA_API_KEY=

# ═══════════════════════════════════════════════════════════
# PROVIDER KEYS (Optional - can also go in openclaw.json)
# ═══════════════════════════════════════════════════════════

# Brave Search API - for web search
# Get one: https://brave.com/search/api
# Note: Usually configured via 'openclaw init', but can be set here
BRAVE_API_KEY=

# ═══════════════════════════════════════════════════════════
# NOTE: Anthropic & Channel tokens are configured via
# 'openclaw init' and stored in ~/.openclaw/openclaw.json
# 
# For cost optimization, see CONFIGURATION.md
#
# Google (Gmail, Calendar) uses OAuth - run:
#   node tools/gmail.js auth
#   node tools/google-calendar.js auth
# ═══════════════════════════════════════════════════════════
